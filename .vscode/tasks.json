{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RM27: Configure Debug",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/cmake.exe",
      "args": ["--preset", "windows-mingw-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Configure Release",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/cmake.exe",
      "args": ["--preset", "windows-mingw-release"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Build Debug",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/cmake.exe",
      "args": ["--build", "--preset", "windows-mingw-debug"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "RM27: Configure Debug",
      "dependsOrder": "sequence",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Build Release",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/cmake.exe",
      "args": ["--build", "--preset", "windows-mingw-release"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "RM27: Configure Release",
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Run Debug Official",
      "type": "process",
      "command": "${workspaceFolder}/build/windows-mingw-debug/bin/RM27_Client.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "D:/Qt6/6.11.2/mingw_64/bin;D:/Qt6/Tools/mingw1310_64/bin;${env:PATH}" }
      },
      "dependsOn": "RM27: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Run Debug Simulation",
      "type": "process",
      "command": "${workspaceFolder}/build/windows-mingw-debug/bin/RM27_Client.exe",
      "args": ["--config", "${workspaceFolder}/configs/simulation.example.json"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "D:/Qt6/6.11.2/mingw_64/bin;D:/Qt6/Tools/mingw1310_64/bin;${env:PATH}" }
      },
      "dependsOn": "RM27: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Run Release Official",
      "type": "process",
      "command": "${workspaceFolder}/build/windows-mingw-release/bin/RM27_Client.exe",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "D:/Qt6/6.11.2/mingw_64/bin;D:/Qt6/Tools/mingw1310_64/bin;${env:PATH}" }
      },
      "dependsOn": "RM27: Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Run Release Simulation",
      "type": "process",
      "command": "${workspaceFolder}/build/windows-mingw-release/bin/RM27_Client.exe",
      "args": ["--config", "${workspaceFolder}/configs/simulation.example.json"],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PATH": "D:/Qt6/6.11.2/mingw_64/bin;D:/Qt6/Tools/mingw1310_64/bin;${env:PATH}" }
      },
      "dependsOn": "RM27: Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: CTest Debug",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/ctest.exe",
      "args": ["--preset", "windows-mingw-debug", "--no-tests=error"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "RM27: Build Debug",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: CTest Release",
      "type": "process",
      "command": "D:/Qt6/Tools/CMake_64/bin/ctest.exe",
      "args": ["--preset", "windows-mingw-release", "--no-tests=error"],
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "RM27: Build Release",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Python Tests",
      "type": "process",
      "command": "E:/miniconda3/python.exe",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-v"],
      "options": { "cwd": "${workspaceFolder}/simulator" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Test Debug",
      "dependsOn": ["RM27: CTest Debug", "RM27: Python Tests"],
      "dependsOrder": "sequence",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "RM27: Test Release",
      "dependsOn": ["RM27: CTest Release", "RM27: Python Tests"],
      "dependsOrder": "sequence",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "RM27: Start Simulator",
      "type": "process",
      "command": "E:/miniconda3/python.exe",
      "args": ["-m", "server.main"],
      "options": { "cwd": "${workspaceFolder}/simulator" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "RM27: Check Simulator",
      "type": "process",
      "command": "E:/miniconda3/python.exe",
      "args": ["-m", "server.main", "--check"],
      "options": { "cwd": "${workspaceFolder}/simulator" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}

